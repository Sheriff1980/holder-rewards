{
  "name": "@holder-rewards/worker",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./src/types.ts",
      "default": "./dist/types.js"
    }
  },
  "scripts": {
    "build": "pnpm --filter @holder-rewards/chains build && wrangler deploy --dry-run --outdir dist --config ../../wrangler.jsonc && tsc -p tsconfig.build.json",
    "dev": "pnpm --filter @holder-rewards/chains build && wrangler dev --config ../../wrangler.jsonc",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @holder-rewards/chains build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@holder-rewards/chains": "workspace:*",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3",
    "uqr": "^0.1.3",
    "viem": "^2.55.10"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260801.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
