# Required: your Discord bot token from the Developer Portal.
DISCORD_BOT_TOKEN=

# Required: the permanent address members and Discord will use.
# Use http://localhost:8787 only for local testing that will not connect to Discord.
PUBLIC_APP_URL=https://rewards.example.com

# Optional: enables shared hosted onboarding at /hosted.
# Add PUBLIC_APP_URL/hosted/callback as a Discord OAuth2 redirect first.
# DISCORD_APPLICATION_ID=
# DISCORD_CLIENT_SECRET=

# Optional overrides.
# PORT=8787
# DATA_DIR=./data
# APP_NAME=Holder Rewards
# REWARD_CURRENCY_NAME=Points
# DAILY_CLAIM_AMOUNT=10
# SETUP_TOKEN=
