{
  "name": "@holder-rewards/node",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @holder-rewards/worker build && tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "dev": "pnpm build && pnpm start",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @holder-rewards/worker build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@holder-rewards/worker": "workspace:*",
    "better-sqlite3": "^12.0.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
