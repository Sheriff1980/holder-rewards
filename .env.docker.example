# Advanced Docker deployment
# This file is not used by the recommended one-click Cloudflare deployment.

# Core
NODE_ENV=development
PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=replace-with-at-least-32-random-characters

# Discord
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
DISCORD_GUILD_ID=

# Database / Queue
DATABASE_URL=postgres://dripclone:dripclone@localhost:5432/dripclone
REDIS_URL=redis://localhost:6379

# Chain Providers
CHAIN_PROVIDERS=mock
SOLANA_RPC_URL=https://rpc.solanatracker.io/public
SOLANA_HELIUS_API_KEY=
EVM_RPC_URL=https://cloudflare-eth.com/v1/mainnet
ALCHEMY_API_KEY=
SIMPLEHASH_API_KEY=

# App Branding
APP_NAME=Holder Rewards
REWARD_CURRENCY_NAME=Points
